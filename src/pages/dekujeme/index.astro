---
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { siteContent } from '../../data/site';
import '../../styles/design-system.css';
---

<!doctype html>
<html lang={siteContent.meta.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteContent.thankYou.title} | WAVE marketing s.r.o.</title>
    <meta name="description" content={siteContent.thankYou.body} />
    {siteContent.assets.icons.map((icon) => <link {...icon} />)}
  </head>
  <body>
    <SiteHeader hrefPrefix="/" />
    <main class="thank-you-page">
      <section class="thank-you-page__card" aria-labelledby="thank-you-heading">
        <p class="thank-you-page__eyebrow">Zpráva odeslána</p>
        <h1 id="thank-you-heading">{siteContent.thankYou.title}</h1>
        <p>{siteContent.thankYou.body}</p>
        <a class="button button-primary" href={siteContent.thankYou.returnHref}>
          {siteContent.thankYou.returnLabel}
        </a>
      </section>
    </main>
    <SiteFooter hrefPrefix="/" />
    <CookieConsent />
  </body>
</html>

<style>
  .thank-you-page {
    align-items: center;
    background: radial-gradient(circle at 50% 20%, color-mix(in srgb, var(--ds-color-secondary) 12%, transparent), var(--ds-color-background) 64%);
    display: flex;
    min-height: 72vh;
    padding: calc(var(--ds-space-24) + 72px) var(--ds-space-gutter-mobile) var(--ds-space-24);
  }

  .thank-you-page__card {
    background: color-mix(in srgb, var(--ds-color-surface-raised) 82%, transparent);
    border: var(--ds-border-width) solid color-mix(in srgb, var(--ds-color-surface-raised) 80%, transparent);
    border-radius: var(--ds-radius-2xl);
    box-shadow: var(--ds-shadow-lg);
    margin: 0 auto;
    max-width: 720px;
    padding: clamp(var(--ds-space-8), 6vw, var(--ds-space-14));
    text-align: center;
  }

  .thank-you-page__eyebrow {
    color: var(--ds-color-secondary);
    font-size: var(--ds-text-sm);
    font-weight: var(--ds-font-weight-semibold);
    letter-spacing: var(--ds-tracking-widest);
    margin: 0 0 var(--ds-space-3);
    text-transform: uppercase;
  }

  .thank-you-page h1 {
    color: var(--ds-color-primary);
    font-family: var(--ds-font-heading);
    font-size: clamp(var(--ds-text-3xl), 5vw, var(--ds-text-5xl));
    margin: 0 0 var(--ds-space-5);
  }

  .thank-you-page p:not(.thank-you-page__eyebrow) {
    color: var(--ds-color-text-muted);
    font-size: var(--ds-text-lead);
    line-height: var(--ds-leading-lead);
    margin: 0 auto var(--ds-space-8);
    max-width: 560px;
  }
  
  .thank-you-page .button {
    justify-content: center;
  }
</style>
