---
import { Image } from "astro:assets";
import janaPhoto from "../assets/jana-skalnikova-photo.png";
import { siteContent } from '../data/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="contact section" id="kontakt" aria-labelledby="contact-heading">
  <div class="container contact__wrap">
    <div class="contact__header">
      <h2 id="contact-heading">{siteContent.contact.heading}</h2>
      <p class="lead">{siteContent.contact.intro}</p>
    </div>
    <div class="contact__module">
      <article class="contact__person-card">
        <div class="contact__person-head">
          <div class="contact__avatar-wrap">
            <Image src={janaPhoto} alt="Jana Skalníková" width={180} height={180} />
            <span class="contact__status-dot" aria-hidden="true"></span>
          </div>
          <div class="contact__person-meta">
            <h3>{siteContent.contact.person.name}</h3>
            <p>{siteContent.contact.person.role}</p>
            <a class="contact__phone-number" href={siteContent.contact.person.phoneHref}>
              {siteContent.contact.person.phoneDisplay}
            </a>
          </div>
        </div>
        <a class="button button-secondary contact__phone" href={siteContent.contact.person.phoneHref}>
          {siteContent.contact.person.phoneLabel}
        </a>
      </article>
      <article class="contact__quick-actions contact__email-card">
          <a href={siteContent.contact.email.href}>
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <span class="contact__action-copy">
              <span>{siteContent.contact.email.label}</span>
              <small>{siteContent.contact.email.display}</small>
            </span>
          </a>
      </article>
      <article class="contact__quick-actions contact__availability-card">
        <span class="material-symbols-outlined" aria-hidden="true">groups</span>
        <div>
          <strong>Kde se můžeme vidět</strong>
          <p class="contact__meeting">{siteContent.contact.meeting}</p>
        </div>
      </article>
      <article class="contact__form-card" aria-labelledby="contact-form-heading" data-contact-form-card>
        <div class="contact__form-default" data-contact-default>
          <div class="contact__form-intro">
            <h3 id="contact-form-heading">{siteContent.contact.form.heading}</h3>
            <p>{siteContent.contact.form.helper}</p>
          </div>
          <form class="contact__form" method="post" action={siteContent.contact.form.action} data-contact-form>
            <div class="contact__field">
              <label for="contact-message">{siteContent.contact.form.label}</label>
              <textarea
                id="contact-message"
                name="contactMessage"
                rows="5"
                placeholder={siteContent.contact.form.placeholder}
                required
              ></textarea>
            </div>
            <label class="contact__consent" for="privacy-consent">
              <input id="privacy-consent" type="checkbox" name="privacyConsent" required />
              <span>{siteContent.contact.form.consent}</span>
            </label>
            {
              turnstileSiteKey ? (
                <div
                  class="cf-turnstile contact__turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-response-field-name="cf-turnstile-response"
                ></div>
              ) : (
                <input type="hidden" name="cf-turnstile-response" value="local-development" />
              )
            }
            <button class="button button-primary contact__submit" type="submit">
              {siteContent.contact.form.submit}
            </button>
            <p class="contact__form-error" role="alert" hidden data-contact-error></p>
          </form>
        </div>
        <div class="contact__form-success" hidden tabindex="-1" data-contact-success>
          <div class="contact__success-heading">
            <span class="contact__success-icon material-symbols-outlined" aria-hidden="true">check_circle</span>
            <h3>{siteContent.contact.form.successTitle}</h3>
          </div>
          <p>{siteContent.contact.form.successBody}</p>
        </div>
      </article>
      <div class="contact__facts-strip" aria-label="Fakturační údaje">
        {siteContent.contact.company.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </div>
</section>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline>
  const contactFormCard = document.querySelector("[data-contact-form-card]");
  const contactDefault = contactFormCard?.querySelector("[data-contact-default]");
  const contactForm = contactFormCard?.querySelector("[data-contact-form]");
  const contactSuccess = contactFormCard?.querySelector("[data-contact-success]");
  const contactError = contactFormCard?.querySelector("[data-contact-error]");

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const submitButton = contactForm.querySelector('button[type="submit"]');
    const originalButtonText = submitButton?.textContent;

    if (contactError) {
      contactError.hidden = true;
      contactError.textContent = "";
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Odesíláme...";
    }

    try {
      const response = await fetch(contactForm.action, {
        body: new FormData(contactForm),
        headers: { Accept: "application/json" },
        method: "POST",
      });
      const payload = await response.json().catch(() => null);

      if (!response.ok || !payload?.ok) {
        throw new Error(
          payload?.message ||
            "Formulář se nepodařilo odeslat. Zkuste to prosím znovu nebo nám napište e-mailem.",
        );
      }

      contactDefault.hidden = true;
      window.dataLayer.push({ event: "contact_form_success" });

      if (contactSuccess) {
        contactSuccess.hidden = false;
        contactSuccess.focus({ preventScroll: true });
        contactSuccess.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }
    } catch (error) {
      if (contactError) {
        contactError.textContent = error instanceof Error
          ? error.message
          : "Formulář se nepodařilo odeslat. Zkuste to prosím znovu nebo nám napište e-mailem.";
        contactError.hidden = false;
      }

      window.turnstile?.reset?.();
    } finally {
      if (!contactDefault.hidden && submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText || "Odeslat nezávaznou poptávku";
      }
    }
  });
</script>

<style>
  .contact {
    background: radial-gradient(circle at 50% 30%, rgba(116, 89, 60, 0.09), var(--ds-color-background) 62%);
    scroll-margin-top: 112px;
  }

  .contact__wrap {
    max-width: 880px;
  }

  .contact__header {
    margin-bottom: var(--ds-space-12);
    text-align: center;
  }

  .contact h2 {
    color: var(--ds-color-primary);
    font-family: var(--ds-font-heading);
    font-size: clamp(var(--ds-text-3xl), 4vw, var(--ds-text-5xl));
  }

  .contact__module {
    display: grid;
    gap: var(--ds-space-5);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .contact__person-card,
  .contact__quick-actions,
  .contact__form-card {
    background: color-mix(in srgb, var(--ds-color-surface-raised) 70%, transparent);
    border: var(--ds-border-width) solid color-mix(in srgb, var(--ds-color-surface-raised) 80%, transparent);
    border-radius: var(--ds-radius-2xl);
    box-shadow: var(--ds-shadow-lg);
    color: var(--ds-color-primary);
    padding: var(--ds-space-6);
  }

  .contact__person-card {
    display: grid;
    gap: var(--ds-space-5);
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }

  .contact__email-card,
  .contact__availability-card {
    grid-column: 3 / 5;
  }

  .contact__person-head {
    align-items: center;
    display: flex;
    gap: var(--ds-space-5);
  }

  .contact__avatar-wrap {
    position: relative;
  }

  .contact__avatar-wrap img {
    border: 4px solid var(--ds-color-surface-raised);
    border-radius: var(--ds-radius-full);
    box-shadow: var(--ds-shadow-md);
    display: block;
    height: 80px;
    object-fit: cover;
    width: 80px;
  }

  .contact__status-dot {
    background: var(--ds-color-success);
    border: 3px solid var(--ds-color-surface-raised);
    border-radius: var(--ds-radius-full);
    bottom: 4px;
    height: 16px;
    position: absolute;
    right: 4px;
    width: 16px;
  }

  .contact__person-card h3 {
    font-family: var(--ds-font-heading);
    font-size: var(--ds-text-2xl);
    margin: 0 0 var(--ds-space-2);
  }

  .contact__person-card p,
  .contact__person-card small,
  .contact__meeting,
  .contact__facts-strip span {
    color: var(--ds-color-text-muted);
  }

  .contact__person-meta p {
    margin: 0 0 var(--ds-space-2);
  }

  .contact__phone-number {
    color: var(--ds-color-primary);
    display: inline-flex;
    font-size: var(--ds-text-sm);
    font-weight: var(--ds-font-weight-medium);
    text-decoration: none;
  }

  .contact__phone {
    justify-content: center;
  }

  .contact__quick-actions {
    align-items: center;
    display: flex;
    gap: var(--ds-space-4);
    text-decoration: none;
  }

  .contact__quick-actions a {
    align-items: center;
    color: inherit;
    display: flex;
    gap: var(--ds-space-4);
    text-decoration: none;
    width: 100%;
  }

  .contact__quick-actions .material-symbols-outlined {
    align-items: center;
    background: var(--ds-color-secondary);
    border-radius: var(--ds-radius-full);
    color: var(--ds-color-secondary-foreground);
    display: inline-flex;
    flex: 0 0 auto;
    height: 44px;
    justify-content: center;
    width: 44px;
  }

  .contact__action-copy {
    display: grid;
    gap: var(--ds-space-1);
  }

  .contact__action-copy small {
    color: var(--ds-color-text-muted);
  }

  .contact__availability-card strong {
    display: block;
    margin-bottom: var(--ds-space-2);
  }

  .contact__meeting {
    margin: 0;
  }

  .contact__form-card {
    display: grid;
    gap: var(--ds-space-5);
    grid-column: 1 / 5;
  }

  .contact__form-intro h3 {
    font-family: var(--ds-font-heading);
    font-size: var(--ds-text-2xl);
    margin: 0 0 var(--ds-space-2);
  }

  .contact__form-intro p {
    color: var(--ds-color-text-muted);
    margin: 0;
  }

  .contact__form-default,
  .contact__form {
    display: grid;
    gap: var(--ds-space-4);
  }

  .contact__form-default[hidden],
  .contact__form[hidden],
  .contact__form-success[hidden],
  .contact__form-error[hidden] {
    display: none;
  }

  .contact__field {
    display: grid;
    gap: var(--ds-space-2);
  }

  .contact__field label {
    color: var(--ds-color-primary);
    font-size: var(--ds-text-sm);
    font-weight: var(--ds-font-weight-semibold);
  }

  .contact__field textarea {
    background: var(--ds-color-surface-raised);
    border: var(--ds-border-width) solid var(--ds-color-border);
    border-radius: var(--ds-radius-xl);
    color: var(--ds-color-text);
    font: inherit;
    min-height: 144px;
    padding: var(--ds-space-4);
    resize: vertical;
  }

  .contact__field textarea:focus-visible,
  .contact__consent input:focus-visible {
    border-color: var(--ds-color-focus);
    outline: 3px solid color-mix(in srgb, var(--ds-color-focus) 32%, transparent);
    outline-offset: 2px;
  }

  .contact__consent {
    align-items: flex-start;
    color: var(--ds-color-text-muted);
    display: flex;
    gap: var(--ds-space-3);
    font-size: var(--ds-text-sm);
  }

  .contact__consent input {
    accent-color: var(--ds-color-primary);
    flex: 0 0 auto;
    height: 20px;
    margin-top: 0.15em;
    width: 20px;
  }

  .contact__turnstile {
    min-height: 65px;
  }

  .contact__submit {
    justify-self: start;
  }

  .contact__submit:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .contact__form-error {
    background: color-mix(in srgb, var(--ds-color-error, #b42318) 10%, var(--ds-color-surface-raised));
    border: var(--ds-border-width) solid color-mix(in srgb, var(--ds-color-error, #b42318) 28%, transparent);
    border-radius: var(--ds-radius-lg);
    color: var(--ds-color-error, #b42318);
    margin: 0;
    padding: var(--ds-space-3) var(--ds-space-4);
  }

  .contact__form-success {
    align-content: center;
    display: grid;
    gap: var(--ds-space-3);
    justify-items: start;
    min-height: 260px;
  }

  .contact__form-success:focus {
    outline: none;
  }

  .contact__success-heading {
    align-items: center;
    display: flex;
    gap: var(--ds-space-4);
  }

  .contact__form-success .contact__success-icon {
    align-items: center;
    background: rgba(0, 59, 61, 0.06);
    border-radius: var(--ds-radius-full);
    color: var(--ds-color-primary);
    display: inline-flex;
    height: 52px;
    justify-content: center;
    width: 52px;
  }

  .contact__form-success h3 {
    font-family: var(--ds-font-heading);
    font-size: var(--ds-text-2xl);
    margin: 0;
  }

  .contact__form-success p {
    color: var(--ds-color-text-muted);
    margin: 0;
    max-width: 44rem;
  }

  .contact__facts-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-3) var(--ds-space-5);
    grid-column: 1 / 5;
    justify-content: center;
    text-align: center;
  }

  .contact__facts-strip span {
    font-size: var(--ds-text-sm);
  }

  @media (max-width: 900px) {
    .contact__header {
      margin-bottom: var(--ds-space-8);
    }

    .contact__module {
      grid-template-columns: 1fr;
    }

    .contact__person-card,
    .contact__email-card,
    .contact__availability-card,
    .contact__form-card,
    .contact__facts-strip {
      grid-column: 1;
      grid-row: auto;
    }

    .contact__person-head {
      align-items: center;
      flex-direction: column;
      text-align: center;
    }

    .contact__quick-actions,
    .contact__quick-actions a {
      align-items: flex-start;
      text-align: left;
    }

    .contact__action-copy {
      justify-items: start;
    }
  }
</style>
