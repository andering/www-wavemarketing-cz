---
import { siteContent } from '../data/site';
---

<section class="services section" id="sluzby" aria-labelledby="services-heading">
  <div class="container">
    <div class="services__header">
      <h2 id="services-heading">{siteContent.services.heading}</h2>
      <p class="lead">{siteContent.services.intro}</p>
      <p class="services__lead">{siteContent.services.lead}</p>
    </div>
    <div class="services__list">
      {siteContent.services.items.map((service) => (
        <article class="service-row">
          <div class="service-row__icon" aria-hidden="true"><span class="material-symbols-outlined">{service.icon}</span></div>
          <div>
            <div class="service-row__heading">
              <h3>{service.title}</h3>
            </div>
            <p>{service.text}</p>
            <div class="service-row__price-slot">
              <span class="service-row__price-tag">{service.priceRange}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="services__footer">
      <p>{siteContent.services.closing}</p>
      <p class="services__pricing">* {siteContent.services.pricingNote}</p>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--ds-color-surface-muted);
    scroll-margin-top: 112px;
  }

  .services__header {
    margin: 0 auto var(--ds-space-12);
    max-width: 860px;
    text-align: center;
  }

  .services h2 {
    color: var(--ds-color-primary);
    font-family: var(--ds-font-heading);
    font-size: clamp(var(--ds-text-3xl), 4vw, var(--ds-text-5xl));
  }

  .service-row p {
    color: var(--ds-color-text-muted);
    line-height: var(--ds-leading-relaxed);
  }

  .services__lead {
    color: var(--ds-color-primary);
    font-weight: var(--ds-font-weight-semibold);
    margin-top: var(--ds-space-6);
  }

  .services__list {
    display: grid;
    gap: 0;
    margin-inline: auto;
    max-width: 980px;
  }

  .service-row {
    align-items: flex-start;
    border-bottom: var(--ds-border-width) solid var(--ds-color-border);
    border-radius: var(--ds-radius-lg);
    display: grid;
    gap: var(--ds-space-6);
    grid-template-columns: auto 1fr;
    padding: var(--ds-space-6);
  }

  .service-row:hover {
    background: color-mix(in srgb, var(--ds-color-surface-raised) 52%, transparent);
  }

  .service-row__icon {
    align-items: center;
    background: rgba(0, 59, 61, 0.06);
    border-radius: var(--ds-radius-full);
    color: var(--ds-color-primary);
    display: inline-flex;
    height: 52px;
    justify-content: center;
    width: 52px;
  }

  .service-row h3 {
    color: var(--ds-color-primary);
    font-family: var(--ds-font-heading);
    font-size: var(--ds-text-2xl);
    margin: 0;
  }

  .service-row__heading {
    align-items: center;
    display: flex;
    margin-bottom: var(--ds-space-3);
  }

  .service-row__price-slot {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--ds-space-5);
  }

  .service-row__price-tag {
    background: var(--ds-color-primary);
    border: 2px solid var(--ds-color-surface-raised);
    border-radius: var(--ds-radius-md);
    box-shadow: 0 3px 0 var(--ds-color-secondary), 0 10px 18px rgba(0, 59, 61, 0.16);
    color: var(--ds-color-surface-raised);
    display: inline-block;
    flex: 0 0 auto;
    font-family: var(--ds-font-body);
    font-size: var(--ds-text-xs);
    font-weight: var(--ds-font-weight-bold);
    letter-spacing: 0.055em;
    line-height: var(--ds-leading-tight);
    padding: 0.42em 0.72em 0.48em;
    text-transform: uppercase;
    transform: rotate(-3deg);
    white-space: nowrap;
  }

  .services__footer {
    color: var(--ds-color-text-muted);
    line-height: var(--ds-leading-relaxed);
    margin: var(--ds-space-10) auto 0;
    max-width: 860px;
    text-align: center;
  }

  .services__footer p {
    margin: 0;
  }

  .services__footer p + p {
    margin-top: var(--ds-space-4);
  }

  .services__pricing {
    font-size: var(--ds-text-sm);
  }

  @media (max-width: 640px) {
    .services__header {
      margin-bottom: var(--ds-space-8);
    }

    .service-row {
      grid-template-columns: 1fr;
    }

    .service-row__price-slot {
      justify-content: flex-end;
    }

    .service-row__price-tag {
      max-width: 100%;
      transform: none;
      white-space: normal;
    }
  }
</style>
